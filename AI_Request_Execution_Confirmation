    alias: AI - Request Execution Confirmation
    mode: single
    fields:
      executor_prompt:
        name: Executor prompt
        required: true
        selector:
          text:
            multiline: true

      user_summary:
        name: User summary
        required: true
        selector:
          text:
            multiline: true

    sequence:
      - action: input_text.set_value
        target:
          entity_id: input_text.ai_pending_executor_prompt
        data:
          value: "{{ executor_prompt[:255] }}"

      - action: input_text.set_value
        target:
          entity_id: input_text.ai_pending_user_summary
        data:
          value: "{{ user_summary[:255] }}"

      - action: persistent_notification.create
        data:
          title: "AI - Conferma richiesta"
          notification_id: ai_pending_execution
          message: >-
            {{ user_summary }}

            Se vuoi procedere, esegui lo script:
            script.ai_confirm_and_execute_pending_prompt
